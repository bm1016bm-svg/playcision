# Copy to .env only for deployment. Never commit real values.
DOMAIN=beta.example.com
BETA_INVITE_CODE=
SESSION_SECRET=

# Public, reusable PAYUNi hosted checkout links for the Playcision merchant.
# These VITE_* values are public and embedded at build time. NEVER add secrets.
# Keep disabled until merchant/credit-card approval and owner payment verification.
VITE_PAYUNI_COLLECTION_ENABLED=false
VITE_PAYUNI_100_URL=
VITE_PAYUNI_500_URL=
VITE_PAYUNI_1000_URL=
VITE_SUPPORT_REPOSITORY_URL=https://github.com/bm1016bm-svg/playcision
