{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "playcision-rooms",
  "main": "cloud/worker.ts",
  "compatibility_date": "2026-10-01",
  "vars": { "APP_ORIGIN": "http://127.0.0.1:4174" },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "PlayRoomObject" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PlayRoomObject"] }]
}
