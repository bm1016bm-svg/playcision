{
  "name": "playcision",
  "version": "0.1.0",
  "description": "Local-first game discovery, deal tracking, and deterministic game rolls.",
  "type": "module",
  "bin": {
    "playcision": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "README.md",
    "README.zh-TW.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node scripts/clean.mjs",
    "build": "npm run build:cli && npm run build:web",
    "build:cli": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "dev": "tsx src/cli.ts",
    "dev:ui": "tsx src/cli.ts ui --dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "check": "npm run typecheck && npm run test && npm run build",
    "prepack": "npm run check",
    "start:beta": "node scripts/start-beta.mjs",
    "beta:preflight": "node scripts/start-beta.mjs --preflight",
    "beta:smoke": "node scripts/beta-smoke.mjs",
    "support:preflight": "tsx scripts/support-preflight.ts",
    "bench:local": "npm run build && node scripts/benchmark-local.mjs",
    "bench:capacity": "tsx scripts/benchmark-capacity.ts",
    "cloud:dev": "wrangler dev --config wrangler.jsonc --local",
    "cloud:bundle": "wrangler deploy --config wrangler.jsonc --dry-run --outdir .wrangler/dry-run",
    "cloud:smoke": "node scripts/cloud-smoke.mjs",
    "cloud:preflight": "node scripts/cloud-preflight.mjs",
    "cloud:deploy": "npm run cloud:preflight && wrangler deploy --config wrangler.jsonc"
  },
  "keywords": [
    "steam",
    "games",
    "deals",
    "wishlist",
    "cli",
    "local-first"
  ],
  "author": "Playcision contributors",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-tc": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "cheerio": "^1.1.2",
    "commander": "^14.0.1",
    "gsap": "^3.15.0",
    "motion": "^13.1.1",
    "open": "^10.2.0",
    "picocolors": "^1.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.22.0",
    "yaml": "^2.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "wrangler": "4.154.0"
  }
}
